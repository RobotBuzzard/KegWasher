// ======================================================================
// KegSecrets.h.example  — TEMPLATE; copy to KegSecrets.h and edit.
// ======================================================================
// `KegSecrets.h` is .gitignore'd so credentials never reach the repo.
// The example version (this file) IS committed so the required keys
// are discoverable by anyone cloning the project.
//
// Bench/dev convention: compile credentials in. For a customer-shipped
// build, plan is to migrate these to a runtime config file on the SD
// card so the firmware binary can be redistributable without baking
// in secrets.
// ======================================================================
#pragma once

// MQTT broker (Mosquitto or any standards-compliant broker).
#define MQTT_BROKER_IP_0   192
#define MQTT_BROKER_IP_1   168
#define MQTT_BROKER_IP_2   1
#define MQTT_BROKER_IP_3   111
#define MQTT_BROKER_PORT   1883

// Credentials for THIS device. Each ClearCore on the LAN should get
// its own account — rotate broker passwords if any account gets shared.
#define MQTT_USER          "rrN"
#define MQTT_PASS          "<paste-from-mosquitto-credentials.txt>"

// MQTT client ID. Must be unique per active connection — a duplicate
// kicks the prior session off the broker.
#define MQTT_CLIENT_ID     "kegwasher-bench"

// Topic root. Every topic this device publishes/subscribes is under
// here, so multiple ClearCores can share one broker by giving each
// a distinct prefix.
#define MQTT_TOPIC_ROOT    "kegwasher"
