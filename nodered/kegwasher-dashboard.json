 {
  "id": "mqtt_state",
  "type": "mqtt in",
  "z": "tab_kw",
  "name": "kegwasher/state",
  "topic": "kegwasher/state",
  "qos": "1",
  "datatype": "utf8",
  "broker": "broker_kw",
  "x": 80,
  "y": 80,
  "wires": [
   [
    "fmt_state",
    "filter_error_state"
   ]
  ]
 },
 {
  "id": "fmt_state",
  "type": "function",
  "z": "tab_kw",
  "name": "PackML state -> badge",
  "func": "// PackML machineState + IDLE sub-state -> one Status badge.\n// Fed by kegwasher/state and kegwasher/state/sub; remembers both.\nif (msg.topic.indexOf('state/sub') >= 0) context.set('sub', msg.payload);\nelse context.set('state', msg.payload);\nvar s   = context.get('state') || '?';\nvar sub = context.get('sub')   || '';\n// IEC-ish palette: green normal/running, amber held/transition, red fault.\nvar colors = {\n  'IDLE':     sub === 'READY' ? '#00aa44' : '#888888',\n  'STARTING': '#0077cc',\n  'EXECUTE':  '#00aa44',\n  'HELD':     '#ffaa00',\n  'COMPLETE': '#00bbcc',\n  'STOPPING': '#ffaa00',\n  'STOPPED':  '#888888',\n  'CLEARING': '#ffaa00',\n  'ABORTED':  '#cc2200'\n};\nmsg.color = colors[s] || '#555555';\nmsg.payload = (s === 'IDLE' && sub) ? s + ' \\u00b7 ' + sub : s;\nreturn msg;",
  "outputs": 1,
  "x": 280,
  "y": 80,
  "wires": [
   [
    "ui_state_text"
   ]
  ]
 },
 {
  "id": "ui_state_text",
  "type": "ui_text",
  "z": "tab_kw",
  "group": "grp_status",
  "order": 1,
  "width": "6",
  "height": "1",
  "name": "State",
  "label": "State",
  "format": "{{msg.payload}}",
  "layout": "row-spread",
  "x": 490,
  "y": 80,
  "wires": []
 },
