 },
 {
  "id": "filter_error_state",
  "type": "function",
  "z": "tab_kw",
  "name": "ABORTED latch + 5min timer",
  "func": "// Alert when the machine sits ABORTED for >5 min with nobody recovering it.\n// Inputs: kegwasher/state, kegwasher/error/message, and a 60 s re-check tick\n// (MQTT publishes are change-detected, so without the tick the age check\n// would only run once and never fire).\nif (msg.topic === 'kegwasher/state') context.set('mach', msg.payload);\nelse if (msg.topic === 'kegwasher/error/message') context.set('errmsg', msg.payload);\n\nif (context.get('mach') === 'ABORTED') {\n  if (!context.get('since')) context.set('since', Date.now());\n  var age = (Date.now() - context.get('since')) / 1000;\n  if (age >= 300) {\n    var m = {payload: 'ABORTED for ' + Math.floor(age / 60) + ' min: ' +\n                  (context.get('errmsg') || 'unknown fault')};\n    return [m, m];   // output 2 = toast (alert only, never the clear)\n  }\n} else if (context.get('since')) {\n  context.set('since', null);\n  return [{payload: ''}, null];   // clear the text display only\n}\nreturn [null, null];",
  "outputs": 2,
  "x": 340,
  "y": 1340,
  "wires": [
   [
    "ui_alert_text"
   ],
   [
    "ui_alert_toast"
   ]
  ]
 },
 {
  "id": "ui_alert_text",
  "type": "ui_text",
  "z": "tab_kw",
  "group": "grp_heartbeat",
  "order": 10,
  "width": "6",
  "height": "1",
  "name": "Error alert",
  "outputs": 0,
  "x": 590,
  "y": 1340,
  "wires": [],
  "label": "ALERT",
  "format": "\u26a0 {{msg.payload}}",
  "layout": "row-spread"
 },
