  {
    "id": "69ab4116.f8b659",
    "type": "mqtt in",
    "z": "tab_kw",
    "name": "kegwasher/# (display)",
    "topic": "kegwasher/#",
    "qos": "1",
    "datatype": "utf8",
    "broker": "broker_kw",
    "x": 100,
    "y": 1460,
    "wires": [
      [
        "e986066f.189d75"
      ]
    ]
  },
  {
    "id": "e986066f.189d75",
    "type": "function",
    "z": "tab_kw",
    "name": "format display",
    "func": "\nvar s = flow.get('kwDisp') || {};\nvar leaf = msg.topic.replace('kegwasher/', '').replace(/\\//g, '_');\ns[leaf] = msg.payload;\nflow.set('kwDisp', s);\n\nfunction fmtTime(sec) {\n    var n = parseInt(sec) || 0;\n    return Math.floor(n/60) + ':' + ('0'+(n%60)).slice(-2);\n}\n\nvar state = s['state'] || '?';\nvar sub   = s['state_sub'] || '';\nvar lines = [];\nvar timedStates = ['DRAINING','RINSING','WASHING','SANITIZE','PRESSURE'];\n\nif (state === 'STARTUP') {\n    if (sub === 'NOT_READY') {\n        lines.push('Robot Keg Washer');\n        lines.push('');\n        lines.push('NOT READY:');\n        if (s['sensors_water'] !== 'OK')     lines.push('  Water offline');\n        if (s['sensors_air']   !== 'OK')     lines.push('  Air offline');\n        if (s['sensors_co2']   !== 'OK')     lines.push('  CO2 offline');\n        if (s['sensors_estop'] === 'ACTIVE') lines.push('  ESTOP open');\n    } else if (sub === 'HEATING') {\n        var ct = parseInt(s['temp_caustic']) || 0;\n        var tt = 60;\n        lines.push('Robot Keg Washer');\n        lines.push('');\n        lines.push('Heating');\n        lines.push(ct + '/' + tt + 'C');\n        lines.push('Level: ' + (s['level_caustic'] || '0') + '%');\n    } else if (sub === 'READY') {\n        lines.push('Robot Keg Washer');\n        lines.push('');\n        lines.push('Check levels');\n        lines.push('Press START');\n    } else {\n        // INIT or unknown \u2014 transitional\n        lines.push('Robot Keg Washer');\n        lines.push('');\n        lines.push('Initializing...');\n    }\n} else if (state === 'FINISHED') {\n    lines.push('Cycle complete!');\n    lines.push('');\n    lines.push('DRAIN: ack alarm');\n    lines.push('START: next keg');\n} else if (state === 'ERROR') {\n    lines.push('ERROR:');\n    lines.push(s['error_message'] || '?');\n    lines.push('');\n    lines.push('DRAIN: silence');\n    lines.push('Hold START: reset');\n} else if (timedStates.indexOf(state) >= 0) {\n    lines.push('Robot Keg Washer');\n    lines.push('Mode: ' + state);\n    lines.push('Keg: ' + (s['keg'] || '?'));\n    lines.push('Time: ' + fmtTime(s['timer_remaining_s']));\n    lines.push('Temp: ' + (s['temp_caustic'] || '--') + 'C');\n    lines.push('Water: ' + (s['sensors_water'] || '?'));\n    lines.push('Air: '   + (s['sensors_air']   || '?'));\n    lines.push('CO2: '   + (s['sensors_co2']   || '?'));\n    if (s['sensors_estop'] === 'ACTIVE') {\n        lines.push('ESTOP ACTIVE!');\n    }\n} else {\n    lines.push('Robot Keg Washer');\n    lines.push('Mode: ' + state);\n}\n\n// Banner \u2014 mirrors the bottom-of-screen banner on the physical Goldelox display\nvar banner = null;\nvar errorBannerMap = {\n    '1':'SD FAIL','2':'CONFIG FAIL','3':'WATER FAULT','4':'AIR FAULT',\n    '5':'CO2 FAULT','6':'TEMP FAULT','7':'OVERHEAT','8':'ESTOP',\n    '10':'HEAT TIMEOUT','11':'HEAT SLOW','12':'CAUSTIC LOW',\n    '13':'HEAT OVERTEMP','14':'TIMEOUT','15':'SENSOR FAIL'\n};\nif (state === 'STARTUP') {\n    if      (sub === 'NOT_READY') banner = { text: 'NOT READY', color: '#cc2200' };\n    else if (sub === 'HEATING')   banner = { text: 'HEATING',   color: '#cc2200' };\n    else if (sub === 'READY')     banner = { text: 'READY',     color: '#22aa44' };\n} else if (state === 'FINISHED') {\n    banner = { text: 'COMPLETE', color: '#22aa44' };\n} else if (state === 'ERROR') {\n    var ec = String(s['error_code'] || '');\n    banner = { text: errorBannerMap[ec] || 'ERROR', color: '#cc2200' };\n}\n\nvar ip = s['ip'] || 'offline';\nvar hasMqtt = s['online'] === 'true';\nvar pad = Math.max(0, 14 - ip.length);\nvar footerIp = ip + Array(pad+1).join(' ');\n\nmsg.payload = { lines: lines, footerIp: footerIp, hasMqtt: hasMqtt, banner: banner };\nreturn msg;\n",
    "outputs": 1,
    "x": 310,
    "y": 1460,
    "wires": [
      [
        "2ee2545b.40c9bf"
      ]
    ]
  },
