  {
    "id": "2ee2545b.40c9bf",
    "type": "ui_template",
    "z": "tab_kw",
    "group": "f91f81b2.776a89",
    "name": "Screen mirror",
    "order": 1,
    "width": "6",
    "height": "8",
    "format": "<div style=\"background:#111;border-radius:5px;padding:10px 13px;font-family:'Courier New',Courier,monospace;font-size:13px;line-height:1.65;border:1px solid #333\">\n  <div ng-if=\"!msg || !msg.payload\" style=\"color:#555\">Waiting...</div>\n  <div ng-if=\"msg && msg.payload\">\n    <div ng-repeat=\"line in msg.payload.lines track by $index\"\n         style=\"white-space:pre;color:#33cc55\">{{line}}</div>\n    <div style=\"white-space:pre\">\n      <span style=\"color:#33cc55\">{{msg.payload.footerIp}}</span\n      ><span style=\"color:#9966cc\" ng-if=\"msg.payload.hasMqtt\">M*</span>\n    </div>\n    <div ng-if=\"msg.payload.banner\"\n         style=\"margin-top:6px;padding:4px 8px;border-radius:3px;text-align:center;font-size:16px;font-weight:bold;letter-spacing:2px;color:#fff\"\n         ng-style=\"{'background': msg.payload.banner.color}\">\n      {{msg.payload.banner.text}}\n    </div>\n  </div>\n</div>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 510,
