    "id": "mqtt_state",
    "type": "mqtt in",
    "z": "tab_kw",
    "name": "kegwasher/state",
    "topic": "kegwasher/state",
    "qos": "1",
    "datatype": "utf8",
    "broker": "broker_kw",
    "x": 80,
    "y": 80,
    "wires": [
      [
        "fmt_state"
      ]
    ]
  },
  {
    "id": "fmt_state",
    "type": "function",
    "z": "tab_kw",
    "name": "state \u2192 badge color",
    "func": "var s = msg.payload;\nvar colors = {\n  'STARTUP':   '#888888',\n  'IDLE':      '#00aa44',\n  'RUNNING':   '#0077cc',\n  'DRAINING':  '#ff8800',\n  'ERROR':     '#cc2200',\n  'ESTOP':     '#ff0000'\n};\nmsg.color = colors[s] || '#555555';\nmsg.payload = s;\nreturn msg;",
    "outputs": 1,
    "x": 280,
    "y": 80,
    "wires": [
      [
        "ui_state_text"
      ]
    ]
  },
  {
    "id": "ui_state_text",
    "type": "ui_text",
    "z": "tab_kw",
    "group": "grp_status",
    "order": 1,
    "width": "6",
    "height": "1",
    "name": "State",
    "label": "State",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 490,
    "y": 80,
    "wires": []
  },
