  {
    "id": "fmt_timer",
    "type": "function",
    "z": "tab_kw",
    "name": "seconds \u2192 mm:ss",
    "func": "var s = parseInt(msg.payload) || 0;\nvar m = Math.floor(s / 60);\nvar ss = ('0' + (s % 60)).slice(-2);\nmsg.payload = m + ':' + ss;\nreturn msg;",
