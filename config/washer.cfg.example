# Keg Washer Configuration File
# Copy this file to "WASHER.CFG" on the SD card root.
# (The filename MUST be 8.3 / UPPERCASE — the ClearCore SD library can't open
#  long names like "washer.config" and silently falls back to defaults.)
# Format: KEY=VALUE, one per line. Lines starting with # are comments.
# Unknown keys are silently ignored, so older firmware tolerates files written
# for newer versions. Any value outside its valid range is logged and ignored
# (the compiled default / prior value is kept), so one typo can't brick a unit.
# Times are milliseconds (1000 = 1 s). Values shown are the compiled defaults.

# ============================================================
# CYCLE STAGE TIMERS  (valid range 5000..1800000 ms = 5 s..30 min)
# In cycle order. Each large-keg run multiplies these by largeKegMod.
# Two-head system: these are per CYCLE (both kegs in parallel), not per keg.
# Defaults below total ~4.4 min/cycle.
# ============================================================

# --- Pre-clean (to drain) ---
dirtyDrainTimer=20000      # air-push old beer out (air + drain, whole stage)
dirtyRinseTimer=20000      # initial water rinse of gross residue
dirtyPurgeTimer=10000      # air-blow the dirty rinse water out

# --- Caustic wash ---
washTimer=90000            # recirculate hot caustic (the main clean)
causticRtnTimer=15000      # air-blow caustic back to its reservoir (NOT drain)

# --- Rinse ---
rinseTimer=25000           # post-caustic water rinse (to drain)
rinsePurgeTimer=10000      # air-blow the rinse water out (to drain)

# Heater control mode (SD-only — not panel-editable):
#   fw  = firmware bang-bang during STARTING (direct contactor wiring; default)
#   ext = ETS50N PNP thermostat regulates the tank (always-hot); the ClearCore
#         output is a safety PERMIT that MUST be wired in series in the heater
#         contactor-coil circuit (with the ETS50N thermostat). E-stop cuts heat
#         separately, by de-powering the coil-circuit feed via an E-stop-relay
#         power contact -- NOT by routing the cycling coil through the DI8 NC
#         sensing loop. ONLY set ext once that chain is wired! Set the ETS50N SP below
#         maxCausticTemp with margin (e.g. SP 60 / RSP 57 vs backstop 70) — the
#         ClearCore faults (ERR_HEATER_OVERTEMP) if temp reaches maxCausticTemp,
#         which means the thermostat failed to regulate.
heaterMode=fw

# Bench mode WITH a card (on|off, default off). on = readiness + resource
# safety gates bypassed, but this file's timers/thresholds are used (unlike
# cardless bench, which also compresses every stage to 5 s). Cardless boots
# are always bench mode regardless of this key.
benchMode=off

# Full-keg drain: DIRTY_DRAIN runs this long INSTEAD of dirtyDrainTimer while
# the latching DRAIN switch (IO2) is on — for sessions of spoiled/undersold
# kegs that arrive full. Keg-size scaled like every stage timer.
fullDrainTimer=180000

# --- Sanitize + seal ---
saniTimer=45000            # recirculate sanitizer
saniRtnTimer=15000         # CO2-blow sanitizer back to its reservoir (NOT drain)
purgeTimer=15000           # CO2 charge FAIL TIMEOUT — phase normally ends early,
                           # when the keg-side pressure switch trips; expiry with
                           # no trip = "Keg not at pressure" fault

# ============================================================
# KEG SIZE MODIFIER  (valid range 1.0..3.0)
# Multiplier applied to every timer when the "large keg" switch is on.
# 1.5 = 50% longer cycles for 1/2 BBL vs 1/6 BBL kegs.
# ============================================================
largeKegMod=1.5

# ============================================================
# PAUSE TIMEOUT  (valid range 60000..3600000 ms = 1..60 min)
# Max time a cycle may sit PAUSED before it alarms and aborts (chem may be
# sitting in the keg). RESUME any time before this expires.
# ============================================================
pauseMaxMs=600000

# ============================================================
# TEMPERATURE THRESHOLDS (°C, valid range 0..120)
# Must be ordered minCausticTemp <= optimalCausticTemp < maxCausticTemp, or
# all three revert to the compiled defaults (logged).
# ============================================================
minCausticTemp=50          # wash floor: below this the amber LOW TEMP banner
                           # shows (READY + operating screens) + warn/lowtemp
                           # on MQTT. WARN-ONLY — never gates or aborts a cycle.
optimalCausticTemp=60      # heater target during STARTING (fw mode warm-up)
maxCausticTemp=70          # caustic safety cutoff (overtemp fault backstop)
# (enclosure temp + fan thresholds removed: the enclosure fan is a standalone
#  self-regulating unit with its own thermometer, off the controller. A9 + CCIO-A7
#  are free. maxEnclosureTemp/fanOnTemp/fanOffTemp keys are now ignored if present.)

# ============================================================
# HEATING BOUNDS
# ============================================================
maxHeatingMs=900000        # STARTING gives up (ERR_HEATING_TIMEOUT) after this
                           # (both heater modes; valid 60000..7200000 = 1 min..2 h)
minHeatingRate=3           # °C/min considered healthy during fw-mode heating
                           # (slower is logged as "Slow heating"; valid 1..50)

# ============================================================
# TEMP SENSOR CALIBRATION (ETS50N 4-20 mA on A-10)
# ============================================================
etsShuntOhms=470.0         # MEASURED value of the installed shunt resistor
                           # (nominal 470 ±5%; valid 100..1000)
tempCalOffsetC10=0         # trim vs a reference thermometer, tenths of a °C
                           # (valid -100..100 = ±10.0 °C)

# ============================================================
# TOUCH CALIBRATION (optional — written by tools/diablo_touch_cal)
# Host-side affine map raw->screen: x' = A*rx + B*ry + C, y' = D*rx + E*ry + F.
# Omit all six to use the firmware's baked-in calibration. If present, ALL six
# should be supplied. Survives panel SETTINGS saves.
# ============================================================
#touchCalA=0.066
#touchCalB=0.000
#touchCalC=-10.0
#touchCalD=0.000
#touchCalE=0.121
#touchCalF=-15.0

# ============================================================
# WEB EDITOR LOGIN (optional). Set BOTH to require a username/password on the
# browser config editor (HTTP Basic auth — a shop-floor lock, not internet
# security). Leave unset/empty for an open editor. Lost the password? Pull
# this card and delete these two lines.
# ============================================================
#webUser=brewer
#webPass=changeme

# ============================================================
# MQTT BROKER  (overrides the compiled KegSecrets.h defaults)
# Lets a shipped binary be configured per-device with no rebuild. All values
# are capped at 29 characters. Omit this whole block to use the compiled creds.
# ============================================================
mqttBrokerIp=192.168.1.111
mqttBrokerPort=1883
mqttUser=rrN
mqttPass=changeme
mqttClientId=kegwasher-1
mqttTopicRoot=kegwasher
