# Arduino / ClearCore build artifacts
build/
*.elf
*.hex
*.bin
*.map
*.lst

# PlatformIO (if used later)
.pio/
.pioenvs/
.piolibdeps/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local-only SD card config (the example stays tracked)
config/washer.config

# Secrets — broker credentials, etc. Use KegSecrets.h.example as the template.
KegSecrets.h

# Vendor reference dumps downloaded from official sources (4D Systems
# PDFs, their .txt extracts, wget'd HTML pages like the 4DGL reference).
# Local-only authoritative lookups — kept on disk for fast/offline reference,
# NOT tracked in the repo. Project documentation (docs/*.md) stays tracked.
docs/*.pdf
docs/*.txt
docs/*.html
docs/--help

# Workshop4 / ViSi-Genie build artifacts. OBSOLETE: the display now uses the raw
# SPE serial path (KegDisplaySerial), so the genie compiled outputs (4XE program +
# GCI/DAT/TXF image/data/font resources) are dead and no longer committed.
KegWasher.4DWork/
*.4XE
KEGW~UCD.gci
KEGW~UCD.dat
KEGW~UCD.txf

# Captured serial protocol traces — large one-shot artifacts, regenerate as needed.
tools/*.strace

# Python cache
__pycache__/
*.pyc
